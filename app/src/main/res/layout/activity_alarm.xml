<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1744"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="BAHAYA GEMPA!"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"/>

    <TextView
        android:id="@+id/tv_alarm_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_alarm_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Anda berada di zona terdampak. Berlindung sekarang!"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAlignment="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_matikan_alarm"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:text="SAYA AMAN (MATIKAN ALARM)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF1744"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="32dp"/>
</RelativeLayout>